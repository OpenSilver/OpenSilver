<Page x:Class="TestApplication.Tests.TriggerTest"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          mc:Ignorable="d"
          d:DesignHeight="1500" d:DesignWidth="800">

    <Page.Resources>
        <!-- ============================================================ -->
        <!-- SECTION 1: BASIC PROPERTY TRIGGERS -->
        <!-- ============================================================ -->
        
        <!-- Style with IsMouseOver trigger -->
        <Style x:Key="MouseOverTriggerStyle" TargetType="Border">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightBlue"/>
                    <Setter Property="BorderBrush" Value="Blue"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style with IsChecked trigger including {x:Null} -->
        <Style x:Key="CheckedTriggerStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="Green"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}">
                    <Setter Property="Foreground" Value="Orange"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- SECTION 2: DATA TRIGGERS -->
        <!-- ============================================================ -->

        <Style x:Key="DataTriggerStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="LightGreen"/>
                    <Setter Property="BorderBrush" Value="Green"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Background" Value="LightCoral"/>
                    <Setter Property="BorderBrush" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- SECTION 3: MULTI-TRIGGERS -->
        <!-- ============================================================ -->

        <Style x:Key="MultiTriggerStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="LightGreen"/>
                    <Setter Property="BorderBrush" Value="Green"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- SECTION 4: MULTI-DATA TRIGGERS -->
        <!-- ============================================================ -->

        <Style x:Key="MultiDataTriggerStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActive}" Value="True"/>
                        <Condition Binding="{Binding IsPremium}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="DarkGoldenrod"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- SECTION 5: EVENT TRIGGERS -->
        <!-- ============================================================ -->

        <Style x:Key="EventTriggerAnimationStyle" TargetType="Border">
            <Setter Property="Background" Value="LightBlue"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                           To="1.1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                           To="1.1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                           To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                           To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- SECTION 6: CONTROL TEMPLATE TRIGGERS -->
        <!-- ============================================================ -->

        <!-- ControlTemplate with Triggers and TargetName -->
        <ControlTemplate x:Key="CustomButtonTemplate" TargetType="Button">
            <Border x:Name="border" 
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="5">
                <ContentPresenter HorizontalAlignment="Center" 
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="LightSkyBlue"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="DeepSkyBlue"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Background" Value="SteelBlue"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Background" Value="LightGray"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="Gray"/>
                    <Setter Property="Foreground" Value="DarkGray"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ControlTemplate with SourceName - monitors a DIFFERENT element's property -->
        <!-- NOTE: Commented out because SourceName and TargetName with properties not on TargetType require -->
        <!-- more complex compiler support and are deferred to a future implementation. -->
        <ControlTemplate x:Key="SourceNameTriggerTemplate" TargetType="ContentControl">
            <Border x:Name="outerBorder" Background="White" BorderBrush="Gray" BorderThickness="1" Padding="10">
                <StackPanel>
                    <TextBox x:Name="inputBox" Text="Type here..." Margin="0,0,0,5"/>
                    <TextBlock x:Name="statusText" Text="TextBox is not focused" Foreground="Gray"/>
                </StackPanel>
            </Border>
            <!--<ControlTemplate.Triggers>
                <!- - SourceName specifies WHICH element's property to monitor - ->
                <!- - TargetName specifies WHERE to apply the setters - ->
                <Trigger SourceName="inputBox" Property="IsFocused" Value="True">
                    <Setter TargetName="statusText" Property="Text" Value="TextBox is focused!"/>
                    <Setter TargetName="statusText" Property="Foreground" Value="Green"/>
                    <Setter TargetName="statusText" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="outerBorder" Property="BorderBrush" Value="Green"/>
                </Trigger>
            </ControlTemplate.Triggers>-->
        </ControlTemplate>

        <!-- ============================================================ -->
        <!-- SECTION 7: DATA TEMPLATE TRIGGERS -->
        <!-- ============================================================ -->

        <DataTemplate x:Key="PersonItemTemplate">
            <Border x:Name="personBorder" 
                    Background="White" 
                    BorderBrush="Gray" 
                    BorderThickness="1" 
                    Padding="10" 
                    Margin="2"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="TEST NOT SUPPORTED IN OPENSILVER YET" FontWeight="Bold" FontSize="14" Foreground="Red"/>
                    <TextBlock x:Name="nameText" Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="ageText" Text="{Binding Age, StringFormat='Age: {0}'}" FontSize="12"/>
                    <TextBlock x:Name="statusText" Text="{Binding Status}" FontSize="11" FontStyle="Italic"/>
                </StackPanel>
            </Border>
            <!-- NOTE: Commented out because SourceName and TargetName with properties not on TargetType require -->
            <!-- more complex compiler support and are deferred to a future implementation. -->
            <!--<DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="personBorder" Property="Background" Value="LightGreen"/>
                    <Setter TargetName="personBorder" Property="BorderBrush" Value="Green"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="personBorder" Property="Background" Value="LightGray"/>
                    <Setter TargetName="nameText" Property="Foreground" Value="DarkGray"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPremium}" Value="True">
                    <Setter TargetName="personBorder" Property="BorderBrush" Value="Gold"/>
                    <Setter TargetName="personBorder" Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActive}" Value="True"/>
                        <Condition Binding="{Binding IsPremium}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="personBorder" Property="Background" Value="Gold"/>
                    <Setter TargetName="nameText" Property="Foreground" Value="DarkRed"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>-->
        </DataTemplate>

        <!-- ============================================================ -->
        <!-- SECTION 8: ENTER/EXIT ACTIONS -->
        <!-- ============================================================ -->

        <Style x:Key="EnterExitActionsStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="LightGray"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                               To="1" Duration="0:0:0.3"/>
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                              To="LightBlue" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                               To="0.7" Duration="0:0:0.3"/>
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                              To="LightGray" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- SECTION 9: STYLE INHERITANCE WITH TRIGGERS -->
        <!-- ============================================================ -->

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Red"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DerivedButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="Green"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- SECTION 10: ATTACHED PROPERTY TRIGGERS -->
        <!-- ============================================================ -->

        <Style x:Key="AttachedPropertyTriggerStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <Trigger Property="Grid.Row" Value="0">
                    <Setter Property="Background" Value="LightBlue"/>
                </Trigger>
                <Trigger Property="Grid.Row" Value="1">
                    <Setter Property="Background" Value="LightGreen"/>
                </Trigger>
                <Trigger Property="Grid.Row" Value="2">
                    <Setter Property="Background" Value="LightCoral"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="WPF Triggers Test Page" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock Text="This page tests trigger functionality with minimal redundancy for code coverage." 
                     TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- SECTION 1: BASIC PROPERTY TRIGGERS -->
            <Border Background="WhiteSmoke" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="1. Property Triggers" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="1.1 IsMouseOver Trigger:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                    <Border Style="{StaticResource MouseOverTriggerStyle}">
                        <TextBlock Text="Hover over this border to see the trigger effect"/>
                    </Border>

                    <TextBlock Text="1.2 IsChecked Trigger (including {x:Null} value):" FontWeight="SemiBold" Margin="0,10,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Style="{StaticResource CheckedTriggerStyle}" Content="Unchecked" IsChecked="False"/>
                        <CheckBox Style="{StaticResource CheckedTriggerStyle}" Content="Checked" IsChecked="True" Margin="20,0,0,0"/>
                        <CheckBox Style="{StaticResource CheckedTriggerStyle}" Content="Indeterminate (null)" IsChecked="{x:Null}" IsThreeState="True" Margin="20,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SECTION 2: DATA TRIGGERS -->
            <Border Background="WhiteSmoke" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="2. DataTrigger" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel x:Name="BooleanDataTriggerPanel">
                        <Border Style="{StaticResource DataTriggerStyle}">
                            <StackPanel>
                                <TextBlock Text="This border changes based on IsActive property"/>
                                <TextBlock Text="{Binding IsActive, StringFormat='IsActive: {0}'}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Toggle IsActive" Click="ToggleIsActive_Click" 
                              HorizontalAlignment="Left" Margin="5" Padding="10,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SECTION 3: MULTI-TRIGGERS -->
            <Border Background="WhiteSmoke" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="3. MultiTrigger (AND Logic)" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="TextBox turns green only when BOTH MouseOver AND IsEnabled (todo: replaced 'IsEnabled' with 'IsFocused' when supported by OpenSilver):" 
                             TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBox Style="{StaticResource MultiTriggerStyle}" 
                           Text="Hover to see green background" Width="350" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- SECTION 4: MULTI-DATA TRIGGERS -->
            <Border Background="WhiteSmoke" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="4. MultiDataTrigger" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Border turns gold only when BOTH IsActive AND IsPremium are true:" 
                             TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <StackPanel x:Name="MultiDataTriggerPanel">
                        <Border Style="{StaticResource MultiDataTriggerStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding IsActive, StringFormat='IsActive: {0}'}"/>
                                <TextBlock Text="{Binding IsPremium, StringFormat='IsPremium: {0}'}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <Button Content="Toggle IsActive" Click="ToggleMultiIsActive_Click" Margin="0,0,5,0" Padding="10,5"/>
                            <Button Content="Toggle IsPremium" Click="ToggleMultiIsPremium_Click" Padding="10,5"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SECTION 5: EVENT TRIGGERS -->
            <Border Background="WhiteSmoke" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="5. EventTrigger with Storyboard" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Scale animation on MouseEnter/MouseLeave:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                    <Border Style="{StaticResource EventTriggerAnimationStyle}">
                        <TextBlock Text="Hover to scale up" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION 6: CONTROL TEMPLATE TRIGGERS -->
            <Border Background="WhiteSmoke" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="6. ControlTemplate Triggers" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="6.1 Triggers with TargetName:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Template="{StaticResource CustomButtonTemplate}" 
                              Content="Custom Button" 
                              Background="LightGray" BorderBrush="Gray" BorderThickness="1"
                              Padding="15,8" Margin="5"/>
                        <Button Template="{StaticResource CustomButtonTemplate}" 
                              Content="Disabled" 
                              Background="LightGray" BorderBrush="Gray" BorderThickness="1"
                              Padding="15,8" Margin="5" IsEnabled="False"/>
                    </StackPanel>

                    <TextBlock Text="6.2 Trigger with SourceName (monitors TextBox, updates TextBlock):" FontWeight="SemiBold" Margin="0,10,0,5"/>
                    <TextBlock Text="TEST NOT SUPPORTED IN OPENSILVER YET" FontWeight="Bold" FontSize="14" Foreground="Red"/>
                    <!--<ContentControl Template="{StaticResource SourceNameTriggerTemplate}" HorizontalAlignment="Left"/>-->
                </StackPanel>
            </Border>

            <!-- SECTION 7: DATA TEMPLATE TRIGGERS -->
            <Border Background="WhiteSmoke" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="7. DataTemplate Triggers" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Person list with DataTemplate triggers (active=green, premium=gold border, both=gold bg):" 
                             FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,5"/>
                    <TextBlock Text="TEST NOT SUPPORTED IN OPENSILVER YET" FontWeight="Bold" FontSize="14" Foreground="Red"/>
                    <ItemsControl x:Name="PersonList"/>
                    <!-- NOTE: Commented out because SourceName and TargetName with properties not on TargetType -->
                    <!-- require more complex compiler support and are deferred. -->
                    <!--<ItemsControl x:Name="PersonList" ItemTemplate="{StaticResource PersonItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>-->
                </StackPanel>
            </Border>

            <!-- SECTION 8: ENTER/EXIT ACTIONS -->
            <Border Background="WhiteSmoke" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="8. Trigger EnterActions/ExitActions" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Animated transition on hover:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                    <Border Style="{StaticResource EnterExitActionsStyle}">
                        <TextBlock Text="Hover for animated transition" 
                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION 9: STYLE INHERITANCE -->
            <Border Background="WhiteSmoke" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="9. Style BasedOn with Triggers" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Base style (on hover: background=red):" Margin="0,0,0,5"/>
                    <Button Style="{StaticResource BaseButtonStyle}" Content="Base Style" HorizontalAlignment="Left"/>
                    <TextBlock Text="Derived style inherits base trigger + adds pressed trigger (background=green, foreground=white):" Margin="0,10,0,5"/>
                    <Button Style="{StaticResource DerivedButtonStyle}" Content="Derived Style" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- SECTION 10: ATTACHED PROPERTY TRIGGERS -->
            <Border Background="WhiteSmoke" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="10. Trigger on Attached Property" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Borders colored based on Grid.Row attached property:" 
                             TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <Grid Width="300" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource AttachedPropertyTriggerStyle}">
                            <TextBlock Text="Row 0 - Light Blue"/>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource AttachedPropertyTriggerStyle}">
                            <TextBlock Text="Row 1 - Light Green"/>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource AttachedPropertyTriggerStyle}">
                            <TextBlock Text="Row 2 - Light Coral"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 11: PROGRAMMATIC TRIGGERS -->
            <Border Background="WhiteSmoke" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="11. Programmatic Style with Triggers" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Button with style and triggers created in code-behind:" Margin="0,0,0,5"/>
                    <Button x:Name="ProgrammaticTriggerButton" Content="Programmatic Triggers" 
                          HorizontalAlignment="Left" Padding="15,8"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
