<Page x:Class="TestApplication.Tests.DataGrids.DataGridCustomTypeProviderTest"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="800">

    <Page.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="10">
        <TextBlock Style="{StaticResource SectionTitle}" Text="DataGrid with ICustomTypeProvider rows" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="Each row is a dictionary whose public properties come only from GetCustomType(). The CLR row class has no public properties, so every column below must come from the custom type." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Add row" Click="OnAddRowClick" Margin="0,0,4,0" />
            <Button Content="First row: Age + 1" Click="OnIncrementAgeClick" Margin="0,0,4,0" />
            <Button Content="Reload with Email property" Click="OnReloadWithEmailClick" Margin="0,0,4,0" />
            <Button Content="Reload original schema" Click="OnReloadOriginalClick" />
        </StackPanel>

        <sdk:DataGrid x:Name="CustomRowsGrid"
                      AutoGenerateColumns="True"
                      Height="220"
                      AutoGeneratingColumn="OnAutoGeneratingColumn" />

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Generated columns: " FontWeight="Bold" />
            <TextBlock x:Name="GeneratedColumnsText" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Expected columns: " FontWeight="Bold" />
            <TextBlock x:Name="ExpectedColumnsText" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Selected row name (Binding SelectedItem.Name): " FontWeight="Bold" />
            <TextBlock Text="{Binding SelectedItem.Name, ElementName=CustomRowsGrid}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                   Text="Checks: the grid shows the expected columns; clicking a header sorts by that custom property; editing a cell updates the row; 'First row: Age + 1' refreshes the Age cell through PropertyChanged; reloading regenerates the columns from the new custom type." />
    </StackPanel>
</Page>
