<sdk:Page x:Class="TestApplication.Tests.MenuTest" 
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           mc:Ignorable="d"
           xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <TextBlock Text="Menu Control Examples" FontSize="18" FontWeight="Bold" Margin="0,10,0,20" HorizontalAlignment="Center"/>

        <!-- Output area to show what was clicked -->
        <Border Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,20" MinWidth="300">
            <StackPanel>
                <TextBlock Text="Last Action:" FontWeight="Bold"/>
                <TextBlock x:Name="OutputTextBlock" Text="(Click menu items to see output)" Foreground="Gray"/>
            </StackPanel>
        </Border>

        <!-- Example: Menu Bar with Nested Submenus -->
        <Border CornerRadius="5" Background="#ECEFF1" Padding="5" Margin="5" HorizontalAlignment="Center" MinWidth="400">
            <StackPanel>
                <TextBlock Text="Menu Bar with Nested Submenus:" FontWeight="Bold" Margin="0,0,0,5"/>
                <Menu Background="#F5F5F5">
                    <MenuItem Header="File">
                        <MenuItem Header="New">
                            <MenuItem Header="Project..." Click="MenuItem_Click"/>
                            <MenuItem Header="File..." Click="MenuItem_Click"/>
                            <MenuItem Header="From Template">
                                <MenuItem Header="Empty Project" Click="MenuItem_Click"/>
                                <MenuItem Header="Console App" Click="MenuItem_Click"/>
                                <MenuItem Header="Web App" Click="MenuItem_Click"/>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="Open">
                            <MenuItem Header="File..." Click="MenuItem_Click"/>
                            <MenuItem Header="Folder..." Click="MenuItem_Click"/>
                            <MenuItem Header="Recent">
                                <MenuItem Header="Project1.sln" Click="MenuItem_Click"/>
                                <MenuItem Header="Document.txt" Click="MenuItem_Click"/>
                                <MenuItem Header="Notes.md" Click="MenuItem_Click"/>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="Save" Click="MenuItem_Click"/>
                        <MenuItem Header="Save As..." Click="MenuItem_Click"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="MenuItem_Click"/>
                    </MenuItem>
                    <MenuItem Header="Edit">
                        <MenuItem Header="Undo" Click="MenuItem_Click"/>
                        <MenuItem Header="Redo" Click="MenuItem_Click"/>
                        <Separator/>
                        <MenuItem Header="Cut" Click="MenuItem_Click"/>
                        <MenuItem Header="Copy" Click="MenuItem_Click"/>
                        <MenuItem Header="Paste">
                            <MenuItem Header="Paste" Click="MenuItem_Click"/>
                            <MenuItem Header="Paste Special..." Click="MenuItem_Click"/>
                            <MenuItem Header="Paste as Path" Click="MenuItem_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Find and Replace">
                            <MenuItem Header="Quick Find" Click="MenuItem_Click"/>
                            <MenuItem Header="Quick Replace" Click="MenuItem_Click"/>
                            <MenuItem Header="Find in Files" Click="MenuItem_Click"/>
                            <MenuItem Header="Replace in Files" Click="MenuItem_Click"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="View">
                        <MenuItem Header="Zoom">
                            <MenuItem Header="Zoom In" Click="MenuItem_Click"/>
                            <MenuItem Header="Zoom Out" Click="MenuItem_Click"/>
                            <MenuItem Header="Reset Zoom" Click="MenuItem_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Full Screen" Click="MenuItem_Click"/>
                        <MenuItem Header="Toolbars">
                            <MenuItem Header="Standard" Click="MenuItem_Click"/>
                            <MenuItem Header="Debug" Click="MenuItem_Click"/>
                            <MenuItem Header="Source Control" Click="MenuItem_Click"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Help">
                        <MenuItem Header="Documentation" Click="MenuItem_Click"/>
                        <MenuItem Header="About" Click="MenuItem_Click"/>
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Border>

        <!-- Example: Menu with Icons in Submenus -->
        <Border CornerRadius="5" Background="#E8EAF6" Padding="5" Margin="5" HorizontalAlignment="Center" MinWidth="400">
            <StackPanel>
                <TextBlock Text="Menu with Icons:" FontWeight="Bold" Margin="0,0,0,5"/>
                <Menu Background="#F5F5F5">
                    <MenuItem Header="Navigation">
                        <MenuItem Header="Back" Click="MenuItem_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/arrow_left.png" Width="16" Height="16" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Forward" Click="MenuItem_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/arrow_right.png" Width="16" Height="16" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Actions">
                        <MenuItem Header="Refresh" Click="MenuItem_Click"/>
                        <MenuItem Header="Settings" Click="MenuItem_Click"/>
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Border>

        <!-- Example: Menu with Disabled Items -->
        <Border CornerRadius="5" Background="#FBE9E7" Padding="5" Margin="5" HorizontalAlignment="Center" MinWidth="400">
            <StackPanel>
                <TextBlock Text="Menu with Disabled Items:" FontWeight="Bold" Margin="0,0,0,5"/>
                <Menu Background="#F5F5F5">
                    <MenuItem Header="Edit">
                        <MenuItem Header="Undo" Click="MenuItem_Click" IsEnabled="False"/>
                        <MenuItem Header="Redo" Click="MenuItem_Click" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem Header="Cut" Click="MenuItem_Click"/>
                        <MenuItem Header="Copy" Click="MenuItem_Click"/>
                        <MenuItem Header="Paste" Click="MenuItem_Click" IsEnabled="False"/>
                    </MenuItem>
                    <MenuItem Header="Tools">
                        <MenuItem Header="Options" Click="MenuItem_Click"/>
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Border>

        <!-- Example: Simple Flat Menu -->
        <Border CornerRadius="5" Background="#E0F2F1" Padding="5" Margin="5" HorizontalAlignment="Center" MinWidth="400">
            <StackPanel>
                <TextBlock Text="Simple Flat Menu (no submenus):" FontWeight="Bold" Margin="0,0,0,5"/>
                <Menu Background="#F5F5F5">
                    <MenuItem Header="Home" Click="MenuItem_Click"/>
                    <MenuItem Header="Products" Click="MenuItem_Click"/>
                    <MenuItem Header="Services" Click="MenuItem_Click"/>
                    <MenuItem Header="About" Click="MenuItem_Click"/>
                    <MenuItem Header="Contact" Click="MenuItem_Click"/>
                </Menu>
            </StackPanel>
        </Border>

    </StackPanel>
</sdk:Page>
