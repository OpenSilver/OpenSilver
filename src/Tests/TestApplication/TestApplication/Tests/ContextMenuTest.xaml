<sdk:Page x:Class="TestApplication.Tests.ContextMenuTest" 
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           mc:Ignorable="d"
           xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <TextBlock Text="ContextMenu Examples" FontSize="18" FontWeight="Bold" Margin="0,10,0,20" HorizontalAlignment="Center"/>

        <!-- Output area to show what was clicked -->
        <Border Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,20" MinWidth="300">
            <StackPanel>
                <TextBlock Text="Last Action:" FontWeight="Bold"/>
                <TextBlock x:Name="OutputTextBlock" Text="(Right-click on any area below)" Foreground="Gray"/>
            </StackPanel>
        </Border>

        <!-- Example 1: Simple Context Menu -->
        <Border CornerRadius="5" Background="#E3F2FD" Padding="15" Margin="5" HorizontalAlignment="Center" MinWidth="280">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Cut" Click="MenuItem_Click"/>
                    <MenuItem Header="Copy" Click="MenuItem_Click"/>
                    <MenuItem Header="Paste" Click="MenuItem_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <TextBlock Text="Right-click for simple menu" TextAlignment="Center"/>
        </Border>

        <!-- Example 2: Context Menu with Icons -->
        <Border CornerRadius="5" Background="#E8F5E9" Padding="15" Margin="5" HorizontalAlignment="Center" MinWidth="280">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Navigate Left" Click="MenuItem_Click">
                        <MenuItem.Icon>
                            <Image Source="/Images/arrow_left.png" Width="16" Height="16" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Navigate Right" Click="MenuItem_Click">
                        <MenuItem.Icon>
                            <Image Source="/Images/arrow_right.png" Width="16" Height="16" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Navigate Both" Click="MenuItem_Click">
                        <MenuItem.Icon>
                            <Image Source="/Images/arrow_right_and_left.png" Width="16" Height="16" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Border.ContextMenu>
            <TextBlock Text="Right-click for menu with icons" TextAlignment="Center"/>
        </Border>

        <!-- Example 3: Context Menu with Separators -->
        <Border CornerRadius="5" Background="#FFF3E0" Padding="15" Margin="5" HorizontalAlignment="Center" MinWidth="280">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New File" Click="MenuItem_Click"/>
                    <MenuItem Header="Open File" Click="MenuItem_Click"/>
                    <MenuItem Header="Save File" Click="MenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="Print" Click="MenuItem_Click"/>
                    <MenuItem Header="Print Preview" Click="MenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="MenuItem_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <TextBlock Text="Right-click for menu with separators" TextAlignment="Center"/>
        </Border>

        <!-- Example 4: Context Menu with Disabled Items -->
        <Border CornerRadius="5" Background="#F3E5F5" Padding="15" Margin="5" HorizontalAlignment="Center" MinWidth="280">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Undo" Click="MenuItem_Click" IsEnabled="False"/>
                    <MenuItem Header="Redo" Click="MenuItem_Click" IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Header="Cut" Click="MenuItem_Click"/>
                    <MenuItem Header="Copy" Click="MenuItem_Click"/>
                    <MenuItem Header="Paste" Click="MenuItem_Click" IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Header="Select All" Click="MenuItem_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <TextBlock Text="Right-click for menu with disabled items" TextAlignment="Center"/>
        </Border>

        <!-- Example 5: Context Menu with Commands -->
        <Border CornerRadius="5" Background="#FFEBEE" Padding="15" Margin="5" HorizontalAlignment="Center" MinWidth="280">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Action 1" Command="{Binding ActionCommand}" CommandParameter="Action 1 executed"/>
                    <MenuItem Header="Action 2" Command="{Binding ActionCommand}" CommandParameter="Action 2 executed"/>
                    <MenuItem Header="Action 3" Command="{Binding ActionCommand}" CommandParameter="Action 3 executed"/>
                </ContextMenu>
            </Border.ContextMenu>
            <TextBlock Text="Right-click for command-bound menu" TextAlignment="Center"/>
        </Border>

        <!-- Example 6: Programmatic Context Menu -->
        <Border x:Name="ProgrammaticMenuBorder" CornerRadius="5" Background="#E0F7FA" Padding="15" Margin="5" HorizontalAlignment="Center" MinWidth="280">
            <TextBlock Text="Right-click for programmatic menu" TextAlignment="Center"/>
        </Border>

    </StackPanel>
</sdk:Page>
