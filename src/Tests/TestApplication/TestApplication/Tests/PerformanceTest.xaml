<sdk:Page x:Class="TestApplication.Tests.PerformanceTest" 
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           mc:Ignorable="d"
           xmlns:sdk="http://schemas.microsoft.com/winfx/2006/xaml/presentation/sdk">
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel>
                <TextBlock Text="OpenSilver Performance Benchmark" 
                           Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Measure rendering performance with heavy workloads" 
                           Foreground="#BDC3C7" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Controls -->
        <Border Grid.Row="1" Background="White" Padding="15" Margin="10">
            <StackPanel>
                <TextBlock Text="Benchmark Configuration" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Element Count:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ElementCountTextBox" Text="5000" 
                             Margin="5" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="(1000-50000)" Foreground="Gray" 
                               VerticalAlignment="Center" FontSize="11"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Nesting Depth:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="NestingDepthTextBox" Text="5" 
                             Margin="5" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="(1-20)" Foreground="Gray" 
                               VerticalAlignment="Center" FontSize="11" Margin="0,5,0,0"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Enable Bindings:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="EnableBindingsCheckBox" IsChecked="True" 
                              Margin="5" VerticalAlignment="Center"/>
                </Grid>
                
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Button x:Name="StartBenchmarkButton" Content="▶ Start Benchmark" 
                            Click="StartBenchmarkButton_Click" 
                            Background="#27AE60" Foreground="Black" 
                            Padding="20,10" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button x:Name="ClearButton" Content="🗑 Clear Results" 
                            Click="ClearButton_Click"
                            Background="#E74C3C" Foreground="Black" 
                            Padding="20,10" Margin="0,0,10,0"/>
                    <Button x:Name="SaveBaselineButton" Content="💾 Save as Baseline" 
                            Click="SaveBaselineButton_Click"
                            Background="#3498DB" Foreground="Black" 
                            Padding="20,10" Margin="0,0,10,0"/>
                    <Button x:Name="CompareButton" Content="📊 Compare to Baseline" 
                            Click="CompareButton_Click"
                            Background="#9B59B6" Foreground="Black" 
                            Padding="20,10"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Status and Results -->
        <Border Grid.Row="2" Background="White" Padding="15" Margin="10,0,10,10">
            <StackPanel>
                <TextBlock Text="Results" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StatusText" Text="Ready" Foreground="#27AE60"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Render Time:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RenderTimeText" Text="--" Margin="0,5,0,0" FontSize="18" FontWeight="Bold"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Elements Created:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ElementCountText" Text="--" Margin="0,5,0,0"/>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Control Types:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BindingCountText" Text="--" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="500"/>
                    
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Baseline Comparison:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ComparisonText" Text="--" Margin="0,5,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Render Target (where heavy content is rendered) -->
        <Border Grid.Row="3" Background="White" Margin="10,0,10,10" BorderBrush="#BDC3C7" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RenderTarget" Background="White"/>
            </ScrollViewer>
        </Border>
        
        <!-- History -->
        <Border Grid.Row="4" Background="#2C3E50" Padding="10">
            <StackPanel>
                <TextBlock Text="Recent Results (stored locally)" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="#ECF0F1" Margin="0,2">
                                <Run Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#BDC3C7"/>
                                <Run Text=" | "/>
                                <Run Text="{Binding ElementCount}"/> 
                                <Run Text=" elements | "/>
                                <Run Text="{Binding RenderTimeMs, StringFormat='{}{0:N0}'}" FontWeight="Bold"/>
                                <Run Text=" ms"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</sdk:Page>

