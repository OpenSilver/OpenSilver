                               Height="100"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Viewport(abs)=(0,0,0,0)"
                               FontSize="11" />
                    <Rectangle Width="150"
                               Height="100"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        ViewportUnits="Absolute"
                                        Viewport="0,0,0,0" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
            </WrapPanel>

            <!-- ============================================================ -->
            <!-- 30. Dynamic property changes — multiple brushes back-to-back  -->
            <!--     to exercise the "stale onload" guard on a single brush:    -->
            <!--     each Rectangle uses a brand-new brush so behavior matches  -->
            <!--     the one on the left after the user resizes the window.    -->
            <!--     See also the brush in section 27 with thick stroke.       -->
            <!-- ============================================================ -->
            <TextBlock Text="30. Same brush, several shapes (each gets its own pattern)"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,8,0,4" />
            <WrapPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Rect 1"
                               FontSize="11" />
                    <Rectangle Width="120"
                               Height="80"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        Viewport="0,0,0.4,0.4" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Rect 2 (different size)"
                               FontSize="11" />
                    <Rectangle Width="200"
                               Height="120"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        Viewport="0,0,0.4,0.4" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Ellipse"
                               FontSize="11" />
                    <Ellipse Width="150"
                             Height="100"
                             Stroke="Gray"
                             StrokeThickness="1">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        Viewport="0,0,0.4,0.4" />
                        </Ellipse.Fill>
                    </Ellipse>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Path"
                               FontSize="11" />
                    <Path Stroke="Gray"
                          StrokeThickness="1"
                          Data="M0,40 L40,0 L160,0 L200,40 L200,80 L160,120 L40,120 L0,80 Z">
                        <Path.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        Viewport="0,0,0.4,0.4" />
                        </Path.Fill>
                    </Path>
                </StackPanel>
            </WrapPanel>

            <!-- ============================================================ -->
            <!-- 31. Stretch=None on every Stretch with various image sizes    -->
            <!--     to compare empty vs cropped behavior visually.            -->
            <!-- ============================================================ -->
            <TextBlock Text="31. Stretch=None — image sizes vs shape size (no Viewbox/Viewport tweaks)"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,8,0,4" />
            <WrapPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="icon (16x16) in 150x100"
                               FontSize="11" />
                    <Rectangle Width="150"
                               Height="100"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/icon_open.png"
                                        Stretch="None" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="arrow (84x29) in 150x100"
                               FontSize="11" />
                    <Rectangle Width="150"
                               Height="100"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/arrow_left.png"
                                        Stretch="None" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Logo (174x197) in 150x100 — crops"
                               FontSize="11" />
                    <Rectangle Width="150"
                               Height="100"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        Stretch="None" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="templates (440x306) in 150x100 — crops"
                               FontSize="11" />
                    <Rectangle Width="150"
                               Height="100"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/flower.jpg"
                                        Stretch="None" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Background (1033x705) in 150x100 — heavy crop"
                               FontSize="11" />
                    <Rectangle Width="150"
                               Height="100"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Background.jpg"
                                        Stretch="None" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
            </WrapPanel>

            <!-- ============================================================ -->
            <!-- 32. Large shapes (stress the renderer on bigger output)       -->
            <!-- ============================================================ -->
            <TextBlock Text="32. Larger shapes"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,8,0,4" />
            <WrapPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="400x300 Tile (Logo)"
                               FontSize="11" />
                    <Rectangle Width="400"
                               Height="300"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        Viewport="0,0,0.2,0.2" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="400x300 Tile abs(60x40)"
                               FontSize="11" />
                    <Rectangle Width="400"
                               Height="300"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        ViewportUnits="Absolute"
                                        Viewport="0,0,60,40" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="500x100 Uniform tall image"
                               FontSize="11" />
                    <Rectangle Width="500"
                               Height="100"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/back_1.jpg"
                                        Stretch="Uniform" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>

