                               FontSize="11" />
                    <Ellipse Width="150"
                             Height="100"
                             Stroke="Gray"
                             StrokeThickness="1">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png" />
                        </Ellipse.Fill>
                    </Ellipse>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Ellipse Tile"
                               FontSize="11" />
                    <Ellipse Width="200"
                             Height="150"
                             Stroke="Gray"
                             StrokeThickness="1">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        Viewport="0,0,0.5,0.5" />
                        </Ellipse.Fill>
                    </Ellipse>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Polygon (triangle) Fill"
                               FontSize="11" />
                    <Polygon Points="75,0 150,100 0,100"
                             Stroke="Gray"
                             StrokeThickness="1">
                        <Polygon.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png" />
                        </Polygon.Fill>
                    </Polygon>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Polygon (triangle) Tile"
                               FontSize="11" />
                    <Polygon Points="100,0 200,150 0,150"
                             Stroke="Gray"
                             StrokeThickness="1">
                        <Polygon.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        Viewport="0,0,0.4,0.4" />
                        </Polygon.Fill>
                    </Polygon>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Polygon (diamond)"
                               FontSize="11" />
                    <Polygon Points="75,0 150,50 75,100 0,50"
                             Stroke="Gray"
                             StrokeThickness="1">
                        <Polygon.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/flower.jpg"
                                        Stretch="Uniform" />
                        </Polygon.Fill>
                    </Polygon>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Path (rounded rect)"
                               FontSize="11" />
                    <Path Stroke="Gray"
                          StrokeThickness="1"
                          Data="M20,0 L130,0 Q150,0 150,20 L150,80 Q150,100 130,100 L20,100 Q0,100 0,80 L0,20 Q0,0 20,0 Z">
                        <Path.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png" />
                        </Path.Fill>
                    </Path>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Path (star)"
                               FontSize="11" />
                    <Path Stroke="Gray"
                          StrokeThickness="1"
                          Data="M75,0 L92,55 L150,55 L102,90 L120,150 L75,115 L30,150 L48,90 L0,55 L58,55 Z">
                        <Path.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/flower.jpg"
                                        Stretch="UniformToFill" />
                        </Path.Fill>
                    </Path>
                </StackPanel>
            </WrapPanel>

            <!-- ============================================================ -->
            <!-- 27. Stroked shapes (stroke does not affect ImageBrush bbox)  -->
            <!-- ============================================================ -->
            <TextBlock Text="27. Stroke thickness should not shift the image"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,8,0,4" />
            <WrapPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Stroke=0"
                               FontSize="11" />
                    <Rectangle Width="150"
                               Height="100">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Stroke=1"
                               FontSize="11" />
                    <Rectangle Width="150"
                               Height="100"
                               Stroke="Black"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Stroke=5"
                               FontSize="11" />
                    <Rectangle Width="150"
                               Height="100"
                               Stroke="Black"
                               StrokeThickness="5">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Stroke=10"
                               FontSize="11" />
                    <Rectangle Width="150"
                               Height="100"
                               Stroke="Black"
                               StrokeThickness="10">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Stroke=10 + Tile"
                               FontSize="11" />
                    <Rectangle Width="200"
                               Height="150"
                               Stroke="Black"
                               StrokeThickness="10">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        Viewport="0,0,0.5,0.5" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Stroke=10 + Tile abs"
                               FontSize="11" />
                    <Rectangle Width="200"
                               Height="150"
                               Stroke="Black"
                               StrokeThickness="10">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        ViewportUnits="Absolute"
                                        Viewport="10,10,60,60" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
            </WrapPanel>

            <!-- ============================================================ -->
            <!-- 28. Heavy combinations (everything at once)                   -->
            <!-- ============================================================ -->
            <TextBlock Text="28. Heavy combinations"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,8,0,4" />
            <WrapPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Tile + Uniform + Viewport(rel) + Viewbox(rel)"
                               FontSize="11" />
                    <Rectangle Width="250"
                               Height="180"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        Stretch="Uniform"
                                        Viewport="0,0,0.4,0.4"
                                        Viewbox="0.1,0.1,0.8,0.8"
                                        AlignmentX="Center"
                                        AlignmentY="Center" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Tile + UniformToFill + Viewbox + Transform"
                               FontSize="11" />
                    <Rectangle Width="250"
                               Height="180"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/flower.jpg"
                                        TileMode="Tile"
                                        Stretch="UniformToFill"
                                        Viewport="0,0,0.25,0.25"
                                        Viewbox="0,0,0.5,0.5">
                                <ImageBrush.Transform>
                                    <RotateTransform Angle="20" />
                                </ImageBrush.Transform>
                            </ImageBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="None + Viewbox abs + Viewport abs + Opacity"
                               FontSize="11" />
                    <Rectangle Width="250"
                               Height="180"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        Stretch="None"
                                        ViewportUnits="Absolute"
                                        Viewport="30,30,180,120"
                                        ViewboxUnits="Absolute"
                                        Viewbox="20,20,120,160"
                                        Opacity="0.7" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Tile + None Stretch + Viewbox(abs) + Alignment"
                               FontSize="11" />
                    <Rectangle Width="250"
                               Height="180"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        Stretch="None"
                                        ViewportUnits="Absolute"
                                        Viewport="0,0,80,80"
                                        ViewboxUnits="Absolute"
                                        Viewbox="20,20,60,60"
                                        AlignmentX="Right"
                                        AlignmentY="Bottom" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Tile + Fill + Viewport-Abs offset + Viewbox-Abs"
                               FontSize="11" />
                    <Rectangle Width="250"
                               Height="180"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        TileMode="Tile"
                                        Stretch="Fill"
                                        ViewportUnits="Absolute"
                                        Viewport="10,10,60,60"
                                        ViewboxUnits="Absolute"
                                        Viewbox="50,50,100,100" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
            </WrapPanel>

            <!-- ============================================================ -->
            <!-- 29. Degenerate / no-op cases                                  -->
            <!-- ============================================================ -->
            <TextBlock Text="29. Degenerate cases (renders nothing)"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,8,0,4" />
            <WrapPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Viewport=(0,0,0,0)"
                               FontSize="11" />
                    <Rectangle Width="150"
                               Height="100"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        Viewport="0,0,0,0" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Viewbox=(0,0,0,0)"
                               FontSize="11" />
                    <Rectangle Width="150"
                               Height="100"
                               Stroke="Gray"
                               StrokeThickness="1">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Tests/TileBrush/Images/Logo1.png"
                                        Viewbox="0,0,0,0" />
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="No ImageSource"
                               FontSize="11" />
