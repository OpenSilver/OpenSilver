                    <TextBlock Text="Fill (default)"
                               FontSize="11" />
                    <Rectangle Width="350"
                               Height="450"
                               Stroke="Gray"
                               StrokeThickness="1"
                               Fill="{StaticResource vb}" />
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Uniform"
                               FontSize="11" />
