<Page x:Class="TestApplication.Tests.AccessTextTest"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="1000">

    <Page.Resources>
        <!-- A button template that honors access-key markers in string content -->
        <Style x:Key="MnemonicButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="#FF2D6CDF"
                                CornerRadius="4"
                                Padding="10,6">
                            <ContentPresenter RecognizesAccessKey="True"
                                              TextElement.Foreground="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#FF1B4FA8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Background" Value="#FFB7C4DC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same template, but WITHOUT recognizing access keys (underscore stays literal) -->
        <Style x:Key="LiteralButton" TargetType="Button" BasedOn="{StaticResource MnemonicButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#FF6A737D" CornerRadius="4" Padding="10,6">
                            <ContentPresenter RecognizesAccessKey="False"
                                              TextElement.Foreground="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF1B4FA8" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6A737D" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition MinWidth="300" Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ============ Left: demos ============ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="16,0">
            <StackPanel>

                <TextBlock Text="AccessText &amp; AccessKeyManager"
                           FontSize="24" FontWeight="Bold" Foreground="#FF202020" />
                <TextBlock Style="{StaticResource Hint}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Text="WPF-style access keys. A '_' before a character marks it as the access key. By default (IsAltKeyRequiredInAccessKeyDefaultScope = false) you can just press the letter; pressing Alt toggles the underline cue. Every activation is recorded in the log on the right."/>

                <!-- 1. AccessText parsing -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="1 · AccessText parsing" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="The control strips the marker, exposes AccessKey, and supports mid-word keys and '__' escaping." />
                <Border Background="#FFF7F9FC" BorderBrush="#FFE0E6EF" BorderThickness="1" Padding="10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <AccessText x:Name="At1" Grid.Row="0" Grid.Column="0" Text="_Save document" FontSize="14" Margin="0,2" />
                        <TextBlock x:Name="At1Key" Grid.Row="0" Grid.Column="1" Style="{StaticResource Hint}" Margin="20,4,0,0" />

                        <AccessText x:Name="At2" Grid.Row="1" Grid.Column="0" Text="Save A_ll" FontSize="14" Margin="0,2" />
                        <TextBlock x:Name="At2Key" Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Margin="20,4,0,0" />

                        <AccessText x:Name="At3" Grid.Row="2" Grid.Column="0" Text="100__ percent (escaped)" FontSize="14" Margin="0,2" />
                        <TextBlock x:Name="At3Key" Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" Margin="20,4,0,0" />
                    </Grid>
                </Border>

                <!-- 2. RecognizesAccessKey -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="2 · ContentPresenter.RecognizesAccessKey" />
                <TextBlock Style="{StaticResource Hint}"
                           TextWrapping="Wrap"
                           Text="Same Content='_Delete' on both buttons. Left recognizes the access key (press D); right keeps the underscore literal." />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource MnemonicButton}" Content="_Delete" Click="Demo_Click" Tag="Delete (recognized, key D)" />
                    <Button Style="{StaticResource LiteralButton}" Content="_Delete" Click="Demo_Click" Tag="Delete (literal underscore)" />
                </StackPanel>

                <!-- 3. Programmatic activation -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="3 · Programmatic activation (AccessKeyManager.ProcessKey)" />
                <TextBlock Style="{StaticResource Hint}"
                           TextWrapping="Wrap"
                           Text="These targets respond to their letter. The bottom buttons invoke them in code via ProcessKey - no keyboard needed." />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Style="{StaticResource MnemonicButton}" Content="_Refresh" Click="Demo_Click" Tag="Refresh (key R)" />
                    <Button Style="{StaticResource MnemonicButton}" Content="E_xport" Click="Demo_Click" Tag="Export (key X)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="ProcessKey('R')" Click="ProcessKey_Click" Tag="R" Padding="8,4" Margin="0,0,8,0" />
                    <Button Content="ProcessKey('X')" Click="ProcessKey_Click" Tag="X" Padding="8,4" />
                </StackPanel>

                <!-- 4. Register / Unregister at runtime -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="4 · Register / Unregister + IsKeyRegistered" />
                <TextBlock Style="{StaticResource Hint}"
                           TextWrapping="Wrap"
                           Text="The element below is registered for key 'G' from code-behind. Toggle the registration and watch IsKeyRegistered update." />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="GoButton" Style="{StaticResource MnemonicButton}" Content="Go (G)" Click="Demo_Click" Tag="Go (manually registered, key G)" />
                    <Button x:Name="ToggleRegButton" Content="Unregister 'G'" Click="ToggleRegistration_Click" Padding="8,4" Margin="8,0,0,0" />
                    <TextBlock x:Name="RegStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- 5. IsDefault / IsCancel -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="5 · IsDefault / IsCancel" />
                <TextBlock Style="{StaticResource Hint}"
                           TextWrapping="Wrap"
                           Text="Focus the text box, then press Enter (default) or Escape (cancel). IsDefaulted shows live while focus is in the box." />
                <TextBox x:Name="DefaultScopeBox" Text="Focus me, then press Enter or Escape"
                         Width="320" HorizontalAlignment="Left" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DefBtn" Content="OK" IsDefault="True" Click="Demo_Click" Tag="OK (IsDefault / Enter)" Padding="14,5" Margin="0,0,8,0" />
                    <Button Content="Cancel" IsCancel="True" Click="Demo_Click" Tag="Cancel (IsCancel / Escape)" Padding="14,5" />
                    <TextBlock x:Name="DefaultedStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- 6. GroupBox header -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="6 · GroupBox header access key" />
                <TextBlock Style="{StaticResource Hint}"
                           TextWrapping="Wrap"
                           Text="Press P to move focus into the group (focuses the first control)." />
                <GroupBox Header="_Preferences" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox Content="First field in the group" />
                        <TextBox Text="Write something" Margin="0,0,0,6" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- ============ Right: live event log ============ -->
        <Border Grid.Column="1" Background="#FF1E1E1E" CornerRadius="6">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Activation log" Foreground="#FFD4D4D4"
                               FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Click="ClearLog_Click" ToolTipService.ToolTip="Clear log"
                            Width="26" Height="26" Padding="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                    <Path x:Name="icon" Width="14" Height="16" Stretch="Uniform"
                                          Stroke="#FFD4D4D4" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M4,6 H20 M9,6 V4 H15 V6 M6,6 L7,20 H17 L18,6 M10,9 V17 M14,9 V17" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#33FFFFFF" />
                                        <Setter TargetName="icon" Property="Stroke" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <ListBox x:Name="LogList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Foreground="#FF9CDCFE" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Grid>
        </Border>
    </Grid>
</Page>
