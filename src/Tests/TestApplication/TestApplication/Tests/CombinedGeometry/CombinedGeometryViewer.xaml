<UserControl x:Class="TestApplication.Tests.CombinedGeometryViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:TestApplication.Tests"
             Width="170"
             Margin="4">

    <UserControl.Resources>
        <local:BooleanToAnyConverter x:Key="booleanToOpacityConverter">
            <local:BooleanToAnyConverter.TrueValue>
                <sys:Double>1</sys:Double>
            </local:BooleanToAnyConverter.TrueValue>
            <local:BooleanToAnyConverter.FalseValue>
                <sys:Double>0</sys:Double>
            </local:BooleanToAnyConverter.FalseValue>
        </local:BooleanToAnyConverter>
        <local:BooleanToAnyConverter x:Key="toggleLabelConverter">
            <local:BooleanToAnyConverter.TrueValue>
                <sys:String>Hide</sys:String>
            </local:BooleanToAnyConverter.TrueValue>
            <local:BooleanToAnyConverter.FalseValue>
                <sys:String>Show</sys:String>
            </local:BooleanToAnyConverter.FalseValue>
        </local:BooleanToAnyConverter>
    </UserControl.Resources>

    <Border BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="4"
            Background="#FAFAFA">
        <StackPanel>
            <Grid Background="#F0F0F0"
                  Height="26">
                <TextBlock Text="{Binding Title}"
                           ToolTip="{Binding Title}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           Margin="8,0,40,0" />
                <TextBlock Text="{Binding ShowResult, Converter={StaticResource toggleLabelConverter}}"
                           FontSize="10"
                           Foreground="#8888AA"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,8,0"
                           Cursor="Hand"
                           MouseLeftButtonDown="Toggle_Click"
                           TextDecorations="Underline" />
            </Grid>

            <Border BorderBrush="#EEEEEE"
                    BorderThickness="0,1,0,0"
                    Background="White"
                    Height="120"
                    Margin="6,4,6,6">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Grid RenderTransform="{Binding Transform}">
                        <Path Data="{Binding Geometry1}"
                              Stroke="#CC4477BB"
                              StrokeThickness="1"
                              StrokeDashArray="3 2"
                              Fill="#384080C0" />
                        <Path Data="{Binding Geometry2}"
                              Stroke="#CCBB5555"
                              StrokeThickness="1"
                              StrokeDashArray="3 2"
                              Fill="#38C04040" />
                    </Grid>
                    <Grid Opacity="{Binding ShowResult, Converter={StaticResource booleanToOpacityConverter}}">
                        <Path Stroke="#1B7A1B"
                              StrokeThickness="1.5"
                              Fill="#882EA82E">
                            <Path.Data>
                                <CombinedGeometry Geometry1="{Binding Geometry1}"
                                                  Geometry2="{Binding Geometry2}"
                                                  GeometryCombineMode="{Binding GeometryCombineMode}"
                                                  Transform="{Binding Transform}" />
                            </Path.Data>
                        </Path>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </Border>

</UserControl>
