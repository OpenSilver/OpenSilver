<Page x:Class="TestApplication.Tests.DoubleAnimationUsingPathTest"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:TestApplication.Tests">

    <Grid Background="#111827">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="20">
            <TextBlock Text="DoubleAnimationUsingPath"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold" />

            <TextBlock Text="Enabled animations"
                       Foreground="#CBD5E1"
                       Margin="0,24,0,6" />

            <CheckBox Content="Animate X"
                      Foreground="White"
                      IsChecked="{Binding AnimateX, Mode=TwoWay}" />

            <CheckBox Content="Animate Y"
                      Foreground="White"
                      IsChecked="{Binding AnimateY, Mode=TwoWay}"
                      Margin="0,8,0,0" />

            <CheckBox Content="Animate Angle"
                      Foreground="White"
                      IsChecked="{Binding AnimateAngle, Mode=TwoWay}"
                      Margin="0,8,0,0" />

            <TextBlock Text="Animation options"
                       Foreground="#CBD5E1"
                       Margin="0,24,0,6" />

            <CheckBox Content="IsCumulative"
                      Foreground="White"
                      IsChecked="{Binding IsCumulative, Mode=TwoWay}" />

            <CheckBox Content="IsAdditive"
                      Foreground="White"
                      IsChecked="{Binding IsAdditive, Mode=TwoWay}"
                      Margin="0,8,0,0" />

            <TextBlock Text="Spiral width"
                       Foreground="#CBD5E1"
                       Margin="0,24,0,4" />

            <Slider Minimum="200"
                    Maximum="760"
                    Value="{Binding SpiralWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Foreground="#94A3B8"
                       Text="{Binding SpiralWidth, StringFormat=Width: {0:F0}}" />

            <TextBlock Text="Spiral height"
                       Foreground="#CBD5E1"
                       Margin="0,16,0,4" />

            <Slider Minimum="120"
                    Maximum="460"
                    Value="{Binding SpiralHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Foreground="#94A3B8"
                       Text="{Binding SpiralHeight, StringFormat=Height: {0:F0}}" />

            <UniformGrid Margin="0,16,0,0" Columns="2">
                <Button Content="Start Animation"
                        Margin="0 0 2 0"
                        Click="OnStartAnimationClick" />
                <Button Content="Stop Animation"
                        Margin="2 0 0 0"
                        Click="OnStopAnimationClick" />
            </UniformGrid>
        </StackPanel>

        <Canvas Grid.Column="1"
                ClipToBounds="True">

            <Path x:Name="PathGlow"
                  Stroke="#38BDF8"
                  StrokeThickness="8"
                  Opacity="0.18"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />

            <Path x:Name="VisiblePath"
                  Stroke="#7DD3FC"
                  StrokeThickness="2"
                  StrokeDashArray="8 5"
                  Opacity="0.9" />

            <Grid x:Name="Rocket"
                  Width="70"
                  Height="36"
                  RenderTransformOrigin="0.5,0.5">

                <Grid.RenderTransform>
                    <TransformGroup>
                        <!-- Add non zero default values for X, Y and Angle to see the effect of the IsAdditive property -->
                        <RotateTransform x:Name="RocketRotate"
                                         Angle="25"/>
                        <TranslateTransform x:Name="RocketTranslate"
                                            X="30"
                                            Y="30" />
                        <TranslateTransform x:Name="RocketPosition" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Polygon Points="0,18 18,8 18,28"
                         Fill="#F97316" />
                <Polygon Points="5,18 18,12 18,24"
                         Fill="#FDBA74" />

                <Border Width="48"
                        Height="24"
                        CornerRadius="12"
                        Background="#E5E7EB"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

                <Polygon Points="52,6 70,18 52,30"
                         Fill="#EF4444" />

                <Ellipse Width="12"
                         Height="12"
                         Fill="#38BDF8"
                         Stroke="#0F172A"
                         StrokeThickness="2"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="18,0,0,0" />
            </Grid>
        </Canvas>
    </Grid>

</Page>
