                                <GradientStop Color="#FFCBCBCB" />
                                <GradientStop Color="#FFFFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="charting:Chart">
                    <Border Background="{TemplateBinding Property={x:Static Control.BackgroundProperty}}"
                            BorderBrush="{TemplateBinding Property={x:Static Control.BorderBrushProperty}}"
                            BorderThickness="{TemplateBinding Property={x:Static Control.BorderThicknessProperty}}"
                            Padding="{TemplateBinding Property={x:Static Control.PaddingProperty}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <datavis:Title Content="{TemplateBinding Property={x:Static Chart.TitleProperty}}"
                                           Style="{TemplateBinding Property={x:Static Chart.TitleStyleProperty}}" />

                            <!-- Use a nested Grid to avoid possible clipping behavior resulting from ColumnSpan+Width=Auto -->
                            <Grid Grid.Row="1" Margin="0,15,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

